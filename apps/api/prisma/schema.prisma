generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

enum LeagueRole {
  MEMBER
  ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  NOT_STARTED
  IN_PROGRESS
  FINISHED
}

enum MatchSource {
  SEED
  API_FOOTBALL
  FOOTBALL_DATA
  MANUAL
}

enum ScoringMode {
  CUMULATIVE
  BEST_ONLY
  MIXED
}

enum RankingCriterion {
  EXACT
  OUTCOME
  SUM_GOALS
}

enum CompetitionPickType {
  WINNER
  TOP_SCORER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  displayName  String       @unique
  // Selected preset avatar (static PNG) from apps/web/public/avatars
  avatarId     String?
  avatarJson   Json?
  passwordHash String
  globalRole   GlobalRole   @default(USER)
  isActive     Boolean      @default(true)
  emailVerifiedAt DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  LeagueMember[]
  predictions  Prediction[]

  // Optional scorer picks ("marcatore" feature)
  scorerPicks  ScorerPick[]

  // Competition predictions (winner / top scorer)
  competitionPicks CompetitionPick[]

  // Awards (best matchday score)
  matchdayAwards MatchdayAward[]

  // Rewarded-ad gating (global across all leagues)
  adUnlock     AdUnlock?
  adUnlockLogs AdUnlockLog[]

  // Email verification
  emailVerificationTokens EmailVerificationToken[]

  // OAuth logins (Google / Microsoft)
  oauthAccounts OAuthAccount[]

  // Push subscriptions
  pushSubscriptions PushSubscription[]

  // Password reset
  passwordResetTokens PasswordResetToken[]
}

model OAuthAccount {
  id             String        @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  email          String?
  userId         String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model League {
  id          String        @id @default(cuid())
  name        String        @unique
  code        String        @unique // short join code
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     LeagueMember[]
  rules       Rule?
  settings    Setting?
  predictions Prediction[]

  // Optional scorer picks ("marcatore" feature)
  scorerPicks     ScorerPick[]

  // Competition predictions (winner / top scorer)
  competitionPicks CompetitionPick[]
  competitionOutcome CompetitionOutcome?

  // Partita Jolly per matchday
  matchdayJollies MatchdayJolly[]

  // Awards (best matchday score)
  matchdayAwards MatchdayAward[]

  // Optional monetization (entry fee + prizes)
  monetization LeagueMonetization?

  // Optional branding (logo, display name tweaks, etc.)
  branding LeagueBranding?
}

// Optional league branding (additive table; deploy-safe)
model LeagueBranding {
  id         String   @id @default(cuid())
  leagueId   String   @unique
  // If Supabase Storage is configured, we store a public URL here.
  logoUrl    String?
  // Fallback when Storage is not configured: store a small data URL.
  logoDataUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId])
}

// Optional league monetization (additive table; deploy-safe)
model LeagueMonetization {
  id            String   @id @default(cuid())
  leagueId      String   @unique
  entryFeeCents Int?
  currency      String   @default("EUR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  prizes LeaguePrize[]

  @@index([leagueId])
}

model LeaguePrize {
  id             String   @id @default(cuid())
  monetizationId String
  position       Int
  amountCents    Int

  monetization LeagueMonetization @relation(fields: [monetizationId], references: [id], onDelete: Cascade)

  @@unique([monetizationId, position])
  @@index([monetizationId])
}

model LeagueMember {
  id        String           @id @default(cuid())
  leagueId  String
  userId    String
  role      LeagueRole       @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId])
}

model Match {
  id          String        @id @default(cuid())
  externalId  String?       @unique
  group       String
  matchday    Int           @default(1)
  homeTeam    String
  awayTeam    String
  homeLogo    String?
  awayLogo    String?
  kickoffAt   DateTime
  status      MatchStatus   @default(NOT_STARTED)
  homeScore   Int?
  awayScore   Int?

  // Optional: cached goal scorers from external provider (used for "marcatore" feature)
  goalScorersJson Json?

  // Cached match detail payload from API-Football (lineups + events), to avoid hitting free-plan rate limits
  apiFootballDetailJson      Json?
  apiFootballDetailFetchedAt DateTime?
  // API-Football v3
  apiFootballFixtureId Int?    @unique
  apiLeagueId          Int?
  apiSeason            Int?
  apiRound             String?

  // football-data.org v4
  footballDataMatchId        Int?    @unique
  footballDataCompetitionCode String?
  footballDataSeason         Int?
  footballDataHomeTeamId     Int?
  footballDataAwayTeamId     Int?

  source      MatchSource   @default(SEED)
  updatedAt   DateTime      @updatedAt

  predictions Prediction[]

  // Optional scorer picks for this match
  scorerPicks ScorerPick[]

  // Jolly selections that reference this match
  matchdayJollies MatchdayJolly[]
}

model Prediction {
  id             String   @id @default(cuid())
  userId         String
  leagueId       String
  matchId        String
  homeGoals      Int
  awayGoals      Int
  pointsExact    Int      @default(0)
  pointsOutcome  Int      @default(0)
  pointsSumGoals Int      @default(0)
  pointsUnderOver Int     @default(0)
  pointsScorer    Int     @default(0)
  totalPoints    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId, matchId])
  @@index([matchId])
  @@index([userId])
  @@index([leagueId])
}

// Optional scorer pick, independent from score prediction
model ScorerPick {
  id        String   @id @default(cuid())
  userId    String
  leagueId  String
  matchId   String
  playerExternalId String
  playerName       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId, matchId])
  @@index([leagueId])
  @@index([matchId])
}

model Rule {
  id                     String     @id @default(cuid())
  leagueId               String     @unique
  pointsExact            Int        @default(4)
  pointsOutcome          Int        @default(2)
  pointsSumGoals         Int        @default(1)
  enableUnderOver25      Boolean    @default(false)
  pointsUnderOver25      Int        @default(1)
  enableMatchdayAwards   Boolean    @default(false)
  scoringMode            ScoringMode @default(CUMULATIVE)
  allowOutcomeWithExact  Boolean    @default(true)
  allowSumGoalsWithExact Boolean    @default(true)
  allowSumGoalsWithOutcome Boolean  @default(true)

  // Under/Over 2.5 cumulability (mainly used for ScoringMode = MIXED)
  // If disabled, Under/Over points are not added when the corresponding category is the "active" one.
  allowUnderOverWithExact    Boolean @default(true)
  allowUnderOverWithOutcome  Boolean @default(true)
  allowUnderOverWithSumGoals Boolean @default(true)

  // Partita Jolly (moltiplicatore punti su una partita per matchday)
  enableJolly           Boolean   @default(false)
  jollyMultiplier       Int       @default(2)

  // Marcatore (se lineup disponibile)
  enableScorer          Boolean   @default(false)
  pointsScorer          Int       @default(3)

  // Pronostici competizione
  enableCompetitionWinner    Boolean @default(false)
  pointsCompetitionWinner    Int     @default(15)
  enableCompetitionTopScorer Boolean @default(false)
  pointsCompetitionTopScorer Int     @default(12)

  // Optional league monetization (all optional, non-destructive)
  // entryFeeCents: participation fee in cents (e.g., 1000 = 10.00€)
  entryFeeCents          Int?
  // prizesJson: array of {position:int, amountCents:int} stored as JSON
  prizesJson             Json?
  updatedAt              DateTime   @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}


model MatchdayJolly {
  id        String   @id @default(cuid())
  leagueId  String
  matchday  Int
  matchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([leagueId, matchday])
  @@index([leagueId])
  @@index([matchId])
}

model MatchdayAward {
  id        String   @id @default(cuid())
  leagueId  String
  matchday  Int
  userId    String
  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, matchday, userId])
  @@index([leagueId, matchday])
  @@index([userId])
}

model CompetitionPick {
  id        String             @id @default(cuid())
  userId    String
  leagueId  String
  type      CompetitionPickType

  // Winner pick
  teamExternalId Int?
  teamName       String?

  // Top scorer pick
  playerExternalId Int?
  playerName       String?

  pointsAwarded Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId, type])
  @@index([leagueId])
  @@index([userId])
}

model CompetitionOutcome {
  id        String   @id @default(cuid())
  leagueId  String   @unique
  provider  String   @default("FOOTBALL_DATA")
  competitionCode String?
  season    Int?

  // Cached options for competition top-scorer selection.
  // football-data.org scorers endpoint may be empty depending on competition/plan;
  // we fallback to team squads and cache the merged player list.
  playerOptionsJson      Json?
  playerOptionsFetchedAt DateTime?

  winnerTeamExternalId Int?
  winnerTeamName       String?
  topScorerPlayerExternalId Int?
  topScorerPlayerName       String?
  resolvedAt DateTime?
  updatedAt  DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model Setting {
  id            String   @id @default(cuid())
  leagueId      String   @unique
  lockUntil     DateTime
  isForceLocked Boolean  @default(false)
  // Tie-breakers used when total points are equal in the leaderboard.
  // The primary criterion is always total points.
  tieBreak1     RankingCriterion @default(EXACT)
  tieBreak2     RankingCriterion @default(OUTCOME)
  tieBreak3     RankingCriterion @default(SUM_GOALS)

  // Deadline per pronostici competizione (winner / top scorer)
  competitionPredictionsDeadline DateTime?
  updatedAt     DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

// Global settings managed only by Super Admin.
// Used for monetization and other global toggles.
model SuperSetting {
  id             String   @id @default(cuid())
  adsEnabled     Boolean  @default(false)
  demoAdsEnabled Boolean  @default(true)
  unlockMinutes  Int      @default(5)

  // External football provider configuration (global)
  // provider: FOOTBALL_DATA | API_FOOTBALL
  provider            String  @default("FOOTBALL_DATA")
  apiFootballLeagueId Int?
  apiFootballSeason   Int?
  apiFootballTimezone String? @default("Europe/Rome")

  footballDataCompetitionCode String?
  footballDataSeason          Int?

  // Optional global window for matches that can be predicted.
  predictionWindowStart DateTime?
  predictionWindowEnd   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Reward unlock window after watching an ad (client-side simulated by default).
// Used to gate access to view other users' predictions for a short time.
model AdUnlock {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId])
  @@index([userId])
}

// Audit log for rewarded-ad unlocks.
model AdUnlockLog {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  minutes   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}


model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

