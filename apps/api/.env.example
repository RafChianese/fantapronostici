# API
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Web (CORS)
WEB_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=7d

# Database (local docker compose default)
DATABASE_URL="postgresql://totomondiale:totomondiale@localhost:5433/totomondiale?schema=public"

# football-data.org v4
# Get a free key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# How often to sync in minutes (default 5)
SYNC_EVERY_MINUTES=5



# Email (SendGrid) - password recovery
# Create an API key in SendGrid: https://app.sendgrid.com/settings/api_keys
# EMAIL_FROM must be a verified Sender Identity in SendGrid (Single Sender Verification works without a domain)
SENDGRID_API_KEY=
EMAIL_FROM=
